{
    "name": "agent-aura",
    "version": "1.0.1",
    "private": false,
    "license": "MIT",
    "type": "module",
    "description": "Zero-dependency effects for Agent UIs: stream glow, neural borders, fire, overclock flames, shape-aware ribbon aura, WebGL2 water / golden cultivation / demonic mist fields, thunder tribulation arcs, void blackhole ribbons, and glitch collapse tears.",
    "keywords": [
        "webgl",
        "webgl2",
        "animation",
        "agent",
        "ai",
        "visual-effects",
        "fire",
        "border",
        "glow",
        "particles",
        "shape-aware",
        "water",
        "cultivation",
        "demonic",
        "thunder",
        "lightning",
        "void",
        "blackhole",
        "glitch"
    ],
    "author": {
        "name": "wangmiao",
        "email": "tuziling84@gmail.com",
        "url": "https://github.com/wangmiaozero"
    },
    "main": "build/index.js",
    "module": "build/index.js",
    "browser": "build/index.js",
    "unpkg": "build/agent-aura.min.js",
    "jsdelivr": "build/agent-aura.min.js",
    "types": "build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/index.js",
            "default": "./build/index.js"
        }
    },
    "files": [
        "build",
        "docs"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/wangmiaozero/agent-aura.git"
    },
    "bugs": {
        "url": "https://github.com/wangmiaozero/agent-aura/issues"
    },
    "homepage": "https://wangmiaozero.github.io/agent-aura/",
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "start": "npm run dev",
        "dev": "npm run build:lib && vite -c vite.config.ts",
        "preview": "npm run build:demo && vite preview -c vite.config.ts --outDir build-demo",
        "build:demo": "npm run build && node scripts/copy-demo.js",
        "build:lib": "vite build -c vite.lib.config.ts",
        "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
        "build": "npm run build:lib && npm run build:types",
        "prepublishOnly": "npm run build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . && prettier --check \"**/*.{ts,js,json,md}\"",
        "format": "prettier --write \"**/*.{ts,js,json,md}\"",
        "prepare": "husky || true"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.1.2",
        "eslint": "^10.8.0",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0"
    },
    "overrides": {
        "typescript": "^6.0.3"
    },
    "lint-staged": {
        "*.{js,ts,cjs,cts,mjs,mts,jsx,tsx}": [
            "prettier --write --ignore-unknown",
            "eslint --quiet --fix"
        ],
        "*.{json,md,css}": [
            "prettier --write --ignore-unknown"
        ]
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ],
        "rules": {
            "subject-case": [
                0,
                "never"
            ]
        }
    },
    "prettier": {
        "singleQuote": true,
        "semi": false,
        "useTabs": true,
        "printWidth": 100,
        "trailingComma": "es5",
        "plugins": [
            "@trivago/prettier-plugin-sort-imports"
        ],
        "importOrder": [
            "<THIRD_PARTY_MODULES>",
            "^(@/).*(?<!css)$",
            "^[./].*(?<!css)$",
            ".css$"
        ],
        "importOrderSeparation": true,
        "importOrderSortSpecifiers": true,
        "overrides": [
            {
                "files": "*.md",
                "options": {
                    "useTabs": false,
                    "tabWidth": 4
                }
            },
            {
                "files": "*.json",
                "options": {
                    "useTabs": false,
                    "tabWidth": 4
                }
            }
        ]
    }
}
